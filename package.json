{
  "name": "@team-monet/aart",
  "version": "0.8.1",
  "description": "Agentic Automation RunTime — a governed block/workflow runtime for AI agents",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/team-monet/aart.git" },
  "homepage": "https://github.com/team-monet/aart#readme",
  "bugs": { "url": "https://github.com/team-monet/aart/issues" },
  "bin": {
    "aart": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "playwright": "^1.60.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "isolated-vm": "^6.1.2"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.14.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
