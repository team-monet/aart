{
  "name": "@team-monet/aart",
  "version": "0.1.0",
  "description": "AART CLI — thin command surface over the AART governed workflow runtime. See aart_architecture_v1.md ADR-18: this is the one package in the monorepo published to npm; the other 13 @aart/* packages are internal, workspace-only, and marked private.",
  "type": "module",
  "bin": {
    "aart": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "build:publish": "tsc -b && node scripts/build-publish.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "isolated-vm": "7.0.0",
    "js-yaml": "4.3.0",
    "playwright": "1.61.1",
    "yaml": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aart/mcp": "workspace:*",
    "@aart/store": "workspace:*",
    "@aart/types": "workspace:*",
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
