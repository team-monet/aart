{
  "id": "item-review",
  "name": "Item Review Workflow",
  "version": "0.1.0",
  "inputs": [
    { "name": "itemId", "type": "string", "required": true },
    { "name": "itemText", "type": "string", "required": true, "description": "The submitted item's description/claims text (submission happens upstream of this workflow)." }
  ],
  "outputs": [],
  "execution": {
    "type": "workflow",
    "steps": [
      {
        "id": "classify_item",
        "uses": "llm.classify",
        "with": {
          "model": "anthropic/claude-sonnet-5",
          "prompt": "Classify this submitted item's text for policy risk: is it compliant, borderline (needs human review), or clearly prohibited (e.g. unsubstantiated claims)?",
          "input": "{{ inputs.itemText }}",
          "labels": ["compliant", "needs_review", "prohibited"]
        }
      },
      {
        "id": "check_rules",
        "uses": "demo.check",
        "with": {
          "itemId": "{{ inputs.itemId }}",
          "itemText": "{{ inputs.itemText }}"
        }
      },
      {
        "id": "score_risk",
        "uses": "demo.score",
        "with": {
          "claimsLabel": "{{ steps.classify_item.outputs.label }}",
          "rulesPassed": "{{ steps.check_rules.outputs.passed }}",
          "violations": "{{ steps.check_rules.outputs.violations }}"
        }
      },
      {
        "id": "human_review",
        "uses": "human.approval",
        "if": "{{ steps.score_risk.outputs.needsReview }}",
        "then": "finalize_reviewed",
        "else": "finalize_auto",
        "with": {
          "title": "Review flagged item",
          "description": "Item {{ inputs.itemId }} was classified \"{{ steps.classify_item.outputs.label }}\" with risk score {{ steps.score_risk.outputs.riskScore }} — review before publish/reject."
        }
      },
      {
        "id": "finalize_reviewed",
        "uses": "demo.publish",
        "with": {
          "itemId": "{{ inputs.itemId }}",
          "reviewStatus": "{{ steps.human_review.outputs.status }}",
          "reviewer": "{{ steps.human_review.outputs.reviewer }}"
        }
      },
      {
        "id": "notify_reviewed",
        "uses": "demo.notify",
        "with": {
          "itemId": "{{ inputs.itemId }}",
          "outcome": "{{ steps.finalize_reviewed.outputs.action }}"
        },
        "next": "item_processed"
      },
      {
        "id": "finalize_auto",
        "uses": "demo.publish",
        "with": {
          "itemId": "{{ inputs.itemId }}",
          "reviewStatus": "auto-approved",
          "reviewer": "risk-engine"
        }
      },
      {
        "id": "notify_auto",
        "uses": "demo.notify",
        "with": {
          "itemId": "{{ inputs.itemId }}",
          "outcome": "{{ steps.finalize_auto.outputs.action }}"
        },
        "next": "item_processed"
      },
      {
        "id": "item_processed",
        "uses": "flow.noop",
        "with": {
          "value": { "itemId": "{{ inputs.itemId }}" }
        }
      }
    ]
  },
  "approval": "approved",
  "gates": {
    "validate": "passed",
    "readiness": "passed",
    "evals": "passed",
    "riskReview": "passed",
    "humanReview": "passed"
  },
  "category": "demo",
  "keywords": ["demo", "flagship", "item-review", "llm-classify", "human-in-the-loop", "conditional-branch"],
  "examples": [
    {
      "description": "A high-risk item (unsubstantiated claims) is classified, fails rule checks, scores high risk, and is routed to human review before publish/reject.",
      "inputs": { "itemId": "item-42", "itemText": "This product is a guaranteed win with zero risk and instant approval — act now, results are certified 100% guaranteed." }
    }
  ]
}
